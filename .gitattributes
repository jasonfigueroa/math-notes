# Detect text and binary files portably by default.
* text=auto

# Repository text uses LF, regardless of the contributor's platform.
*.tex text eol=lf
*.bib text eol=lf
*.sty text eol=lf
*.cls text eol=lf
*.dtx text eol=lf
*.ins text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Windows command scripts use CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Keep common figure and document assets binary.
*.bmp binary
*.gif binary
*.ico binary
*.jpeg binary
*.jpg binary
*.pdf binary
*.png binary
*.tif binary
*.tiff binary
*.webp binary
